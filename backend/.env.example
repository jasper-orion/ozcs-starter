# Kopieer dit bestand naar .env (in PowerShell: Copy-Item .env.example .env).
# .env staat in .gitignore en gaat nooit mee naar GitHub.
# De app werkt ook zonder .env: dan gelden de standaardwaarden uit app/config.py.

# Lokaal een SQLite-bestand. In productie wijst dit naar Azure SQL, de rest van de code blijft gelijk.
DATABASE_URL=sqlite:///./lokalen.db

# Welke websites de API vanuit de browser mogen aanroepen (CORS-allowlist), als JSON-lijst.
CORS_ORIGINS=["http://localhost:5173"]

# In productie vult de pipeline hier het buildnummer in.
APP_VERSION=dev

# Testgebruikers via de header X-Dev-User. Zet dit in productie op false.
DEV_AUTH_ENABLED=true
